# POLIS environment configuration — Implementation Plan task 1.5, TRD §10.4
#
# THIS FILE IS COMMITTED. Every value is empty or a non-secret default.
# Copy to `.env` and fill in locally. `.env` is git-ignored and must never
# be committed, logged, or pasted into any document (SEC-17).
#
# CI asserts that no key matching SECRET|PASSWORD|TOKEN|KEY|HASH has a value
# after the `=` in this file.

# ---- Application ----
POLIS_ENV=local                      # local | test | demo | production
POLIS_DEBUG=false                    # MUST be false outside local (SEC-19)
POLIS_LOG_LEVEL=INFO

# ---- Database ----
DATABASE_URL=postgresql+psycopg://polis_app:@localhost:5432/polis

# ---- Security ----
JWT_SECRET=                          # 32+ random bytes; generate per environment
JWT_ISSUER=polis
JWT_AUDIENCE=polis-api
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_HOURS=8
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---- Ingestion ----
# Poll interval is DERIVED from the PRD §11.1 latency budget, not chosen freely.
# Raising it above 10 breaks NFR-1.5a.
INGEST_USER_AGENT=POLIS-Academic-Research/1.0 (university FYP; contact: )
INGEST_TIMEOUT_SECONDS=10
INGEST_MAX_BYTES=2097152
INGEST_INTERVAL_MINUTES=10

# ---- Source credentials (free tiers) ----
# Credentials live HERE ONLY — never in the database, never in the admin UI,
# never in `sources.config` (DB §5.2).
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_NAME=polis
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=

# ---- ML ----
MODEL_ARTIFACT_URI=                  # hf://org/polis-xlmr-v1 or a local path
MODEL_DEVICE=cpu
MODEL_MAX_TOKENS=512
MODEL_BATCH_SIZE=8
# Batch cap for one pipeline_cycle stage C. PRD §11.1 budget assumes <=100 at
# 1.5s/item => 2.5 min. If Phase 3 benchmarking lands near the NFR-1.4 floor
# (300 items/hr) instead, this must drop to ~25 (TBD-16).
MODEL_SCORING_BATCH_LIMIT=100
MODEL_CONFIDENCE_FLOOR=0.55

# ---- Retention (days) — PRIV-4 ----
RETAIN_RAW_CONTENT_DAYS=180
RETAIN_NLP_RESULTS_DAYS=365
RETAIN_AUDIT_DAYS=365
